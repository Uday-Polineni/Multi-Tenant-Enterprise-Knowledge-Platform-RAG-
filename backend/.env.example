# Copy to .env and fill in values
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/eka

# Used in Step 15+ (auth)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=14

# PDF uploads (relative to backend/ when running uvicorn)
UPLOAD_DIR=data/uploads

# Day 3 — OpenAI + Chroma (embeddings + RAG)
OPENAI_API_KEY=sk-your-key-here
CHROMA_PERSIST_DIR=data/chroma
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Day 4 — RBAC + invites
ALLOW_PUBLIC_REGISTRATION=true
INVITE_EXPIRE_DAYS=7

# Day 5 — RAG retrieval + reranker
RAG_SEARCH_TOP_K=30
RAG_RERANK_TOP_N=20
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base

# Ingest — chunk size at upload (re-upload PDFs after changing)
INGEST_CHUNK_MAX_CHARS=1000
INGEST_CHUNK_OVERLAP_CHARS=100

# LLM context — defaults match ingest size so chunks are sent whole (no head truncation)
RAG_LLM_CONTEXT_CHUNKS=20
RAG_CHUNK_MAX_CHARS=1000

# Day 6 — Redis (local: docker compose -f docker/docker-compose.yml up -d redis)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_HOUR=100
EMBED_ASYNC=true

# Phase B1 — semantic cache (invalidated via org cache version bump on upload/delete)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=200

# Phase B2 — Postgres full-text + Chroma vector hybrid (RRF merge)
HYBRID_SEARCH_ENABLED=true
HYBRID_RRF_K=60

# Tier 1 retrieval — topic routing + query decomposition for multi-part employee questions
TOPIC_ROUTING_ENABLED=true
QUERY_DECOMPOSITION_ENABLED=true
RAG_SUBQUERY_TOP_K=12

# Prototype — upload caps (0 = unlimited, used by regression tests)
PROTOTYPE_MAX_PDF_PAGES=15
PROTOTYPE_MAX_DOCUMENTS_PER_ORG=15

# Optional demo admin (seeded on startup; pair with frontend VITE_DEMO_ADMIN_*)
# DEMO_ADMIN_EMAIL=demo@eka.example.com
# DEMO_ADMIN_PASSWORD=DemoAdmin123!
# DEMO_ORG_NAME=Demo Organization
