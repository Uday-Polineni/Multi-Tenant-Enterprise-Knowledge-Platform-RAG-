# Copy to docker/.env before: docker compose up --build
# cp .env.example .env

# EC2 HTTPS (free): set to your instance Public IPv4 DNS, then run ./setup-https.sh
NGINX_HOST=ec2-3-15-42-88.us-east-2.compute.amazonaws.com
CERTBOT_WEBROOT=/var/www/certbot
CERTBOT_CONF=/etc/letsencrypt

POSTGRES_PASSWORD=change-me-strong-password

DATABASE_URL=postgresql://eka:change-me-strong-password@postgres:5432/eka
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=14

OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

ALLOW_PUBLIC_REGISTRATION=false
INVITE_EXPIRE_DAYS=7

# Demo login (seeded on API startup; shown on sign-in page when frontend vars match)
DEMO_ADMIN_EMAIL=demo@eka.example.com
DEMO_ADMIN_PASSWORD=DemoAdmin123!
DEMO_ORG_NAME=Demo Organization

UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma

RERANKER_ENABLED=false
EMBED_ASYNC=true
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_HOUR=100

SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
HYBRID_SEARCH_ENABLED=true

PROTOTYPE_MAX_PDF_PAGES=15
PROTOTYPE_MAX_DOCUMENTS_PER_ORG=15
