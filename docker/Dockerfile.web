FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

COPY frontend/ .

# Same-origin API via nginx — browser calls /api/v1/...
ARG VITE_API_BASE_URL=
ARG VITE_DEMO_ADMIN_EMAIL=
ARG VITE_DEMO_ADMIN_PASSWORD=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_DEMO_ADMIN_EMAIL=$VITE_DEMO_ADMIN_EMAIL \
    VITE_DEMO_ADMIN_PASSWORD=$VITE_DEMO_ADMIN_PASSWORD

RUN npm run build

FROM nginx:1.27-alpine

RUN apk add --no-cache gettext

COPY docker/nginx.init.conf.template /etc/nginx/templates/
COPY docker/nginx.ssl.conf.template /etc/nginx/templates/
COPY docker/nginx-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443
ENTRYPOINT ["/docker-entrypoint.sh"]
